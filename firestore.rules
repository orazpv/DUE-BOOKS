rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function membershipId(orgId) { return orgId + '_' + request.auth.uid; }
    function membership(orgId) {
      return get(/databases/$(database)/documents/org_memberships/$(membershipId(orgId)));
    }
    function activeMember(orgId) {
      return signedIn()
        && exists(/databases/$(database)/documents/org_memberships/$(membershipId(orgId)))
        && membership(orgId).data.status == 'active'
        && membership(orgId).data.userId == request.auth.uid;
    }
    function role(orgId, allowed) {
      return activeMember(orgId) && membership(orgId).data.role in allowed;
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /organizations/{orgId} {
      allow create: if signedIn()
        && request.resource.data.id == orgId
        && request.resource.data.ownerUid == request.auth.uid;
      allow read: if activeMember(orgId);
      allow update: if role(orgId, ['admin'])
        && request.resource.data.id == resource.data.id
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if role(orgId, ['admin']);
    }

    match /org_memberships/{id} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid || activeMember(resource.data.orgId)
      );
      allow create: if signedIn() && (
        (request.resource.data.userId == request.auth.uid
          && request.resource.data.id == request.resource.data.orgId + '_' + request.auth.uid
          && get(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)).data.ownerUid == request.auth.uid
          && request.resource.data.role == 'admin')
        || role(request.resource.data.orgId, ['admin'])
      );
      allow update: if role(resource.data.orgId, ['admin'])
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.userId == resource.data.userId;
      allow delete: if role(resource.data.orgId, ['admin']);
    }

    match /members/{id} {
      allow read: if activeMember(resource.data.orgId);
      allow create: if role(request.resource.data.orgId, ['admin', 'treasurer', 'financial_sec']);
      allow update: if role(resource.data.orgId, ['admin', 'treasurer', 'financial_sec'])
        && request.resource.data.orgId == resource.data.orgId;
      allow delete: if role(resource.data.orgId, ['admin']);
    }

    match /contributions/{id} {
      allow read: if activeMember(resource.data.orgId);
      allow create: if role(request.resource.data.orgId, ['admin', 'treasurer', 'financial_sec']);
      allow update: if role(resource.data.orgId, ['admin', 'treasurer', 'financial_sec'])
        && request.resource.data.orgId == resource.data.orgId;
      allow delete: if role(resource.data.orgId, ['admin']);
    }

    match /payments/{id} {
      allow read: if activeMember(resource.data.orgId);
      allow create: if role(request.resource.data.orgId, ['admin', 'treasurer', 'financial_sec'])
        && request.resource.data.status == 'confirmed'
        && request.resource.data.amount is int
        && request.resource.data.amount > 0;
      allow update: if role(resource.data.orgId, ['admin', 'treasurer'])
        && request.resource.data.orgId == resource.data.orgId
        && resource.data.status == 'confirmed'
        && request.resource.data.status == 'reversed'
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.receiptNumber == resource.data.receiptNumber
        && request.resource.data.memberId == resource.data.memberId;
      allow delete: if false;
    }

    match /expenses/{id} {
      allow read: if activeMember(resource.data.orgId);
      allow create: if role(request.resource.data.orgId, ['admin', 'treasurer', 'financial_sec'])
        && request.resource.data.amount is int
        && request.resource.data.amount > 0;
      allow update: if role(resource.data.orgId, ['admin', 'treasurer', 'financial_sec'])
        && request.resource.data.orgId == resource.data.orgId;
      allow delete: if false;
    }

    match /audit_events/{id} {
      allow read: if activeMember(resource.data.orgId);
      allow create: if role(request.resource.data.orgId, ['admin', 'treasurer', 'financial_sec'])
        && request.resource.data.actorEmail == request.auth.token.email;
      allow update, delete: if false;
    }
  }
}
